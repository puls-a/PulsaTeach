VITE_API_URL=http://127.0.0.1:4174

# Functional local development defaults.
PULSATEACH_STORAGE=json
VITE_AUTH_MODE=local
PULSATEACH_ALLOW_LOCAL_IDENTITY=true
PULSATEACH_ADMIN_KEY=dev-admin-key
VITE_ADMIN_ACCESS_KEY=dev-admin-key
PULSATEACH_ALLOWED_ORIGINS=http://127.0.0.1:5173
PULSATEACH_RATE_LIMIT=300
PULSATEACH_ANALYTICS_SALT=replace-with-a-long-random-production-secret
PULSATEACH_EXAM_SECRET=replace-with-a-different-long-random-exam-secret

# Supabase configuration. Required in production.
# Switch PULSATEACH_STORAGE to "supabase" for automatic JSON fallback,
# or "supabase-strict" to fail when Supabase is unavailable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PulsaBot integration. Keep both secrets server-side only.
PULSABOT_API_URL=https://pulsabot.130-110-241-167.sslip.io
PULSABOT_API_KEY=replace-with-a-long-random-production-secret
PULSABOT_LINK_SIGNING_SECRET=replace-with-a-different-link-signing-secret
PULSATEACH_WEBHOOK_SECRET=replace-with-a-different-long-random-production-secret
PULSABOT_RATE_LIMIT=3000
CRON_SECRET=replace-with-a-long-random-maintenance-secret

# Production requirements:
# PULSATEACH_STORAGE=supabase-strict
# PULSATEACH_ALLOWED_ORIGINS=https://pulsateach.vercel.app
# PULSATEACH_EXAM_SECRET, CRON_SECRET and enabled Discord secrets must be distinct.
# Enable the Discord variables only as a complete set: API URL, API key, link
# signing secret, and webhook secret.
# Never configure PULSATEACH_ALLOW_LOCAL_IDENTITY, PULSATEACH_ADMIN_KEY
# or VITE_ADMIN_ACCESS_KEY in production.
