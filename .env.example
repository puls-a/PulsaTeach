VITE_API_URL=http://127.0.0.1:4174

# Functional local development defaults.
PULSATEACH_STORAGE=json
VITE_AUTH_MODE=local
PULSATEACH_ALLOW_LOCAL_IDENTITY=true
PULSATEACH_ADMIN_KEY=dev-admin-key
VITE_ADMIN_ACCESS_KEY=dev-admin-key
PULSATEACH_ALLOWED_ORIGINS=http://127.0.0.1:5173
PULSATEACH_RATE_LIMIT=300

# Optional Supabase configuration.
# Switch PULSATEACH_STORAGE to "supabase" for automatic JSON fallback,
# or "supabase-strict" to fail when Supabase is unavailable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production requirements:
# PULSATEACH_STORAGE=supabase-strict
# PULSATEACH_ALLOWED_ORIGINS=https://pulsateach.vercel.app
# Never configure PULSATEACH_ALLOW_LOCAL_IDENTITY, PULSATEACH_ADMIN_KEY
# or VITE_ADMIN_ACCESS_KEY in production.
