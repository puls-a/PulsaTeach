# Ajouter ces variables au .env racine local (ignoré par Git).
# Jeton Meta Instagram Login ; pas le mot de passe Instagram.
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
# Version Graph prise en charge par votre application Meta, ex. vXX.0
IG_API_VERSION=
# Répertoire HTTPS public contenant les fichiers *-vertical.mp4
IG_MEDIA_BASE_URL=
IG_EXPECTED_USERNAME=pulsateach_
IG_PUBLISH_ENABLED=false
