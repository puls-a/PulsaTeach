{
  "name": "pulsateach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "validate": "npm run lint && npm run audit:learning && npm run build",
    "audit:learning": "node scripts/audit-learning.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:full": "node scripts/smoke-full.mjs",
    "dev:e2e": "cross-env VITE_AUTH_MODE=local PULSATEACH_STORAGE=json VITE_API_URL=http://127.0.0.1:4188 PORT=4188 concurrently \"npm run server\" \"npm run dev -- --port 5188\"",
    "dev:e2e:supabase": "cross-env VITE_AUTH_MODE=supabase PULSATEACH_STORAGE=supabase-strict VITE_API_URL=http://127.0.0.1:4190 PORT=4190 concurrently \"npm run server\" \"npm run dev -- --port 5190\"",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "cross-env E2E_SUPABASE=true playwright test --config=playwright.supabase.config.js",
    "roles:set": "node scripts/set-user-roles.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  }
}
